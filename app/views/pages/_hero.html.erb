<section class="relative overflow-hidden bg-harbor-900">
  <%# Harbor at dusk: a warm band low on the horizon under a deep sky. %>
  <div class="absolute inset-0 bg-gradient-to-b from-harbor-950 via-harbor-800 to-harbor-700" aria-hidden="true"></div>
  <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-brick-900/40 via-gold-600/10 to-transparent" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl px-4 pt-16 pb-44 sm:px-6 sm:pt-24 sm:pb-56 lg:pt-32 lg:pb-64">
    <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm font-medium tracking-wide text-gold-300 uppercase">
      <span>Baltimore, Maryland</span>
      <span class="text-harbor-400" aria-hidden="true">/</span>
      <span>Free and open to everyone</span>
    </p>

    <h1 class="mt-4 max-w-3xl font-display text-4xl leading-[1.05] font-bold text-marble-50 sm:text-5xl lg:text-6xl">
      Baltimore's Ruby and&nbsp;Rails community
    </h1>

    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-harbor-100 sm:mt-6 sm:text-xl">
      We meet monthly to talk shop, share what we're building, and help each
      other get better at Ruby. Whether you shipped your first Rails app this
      week or you've been at it since 2005, there's a seat for you.
    </p>

    <div class="mt-8 flex flex-col gap-3 sm:mt-10 sm:flex-row sm:items-center">
      <%= link_to Site::LUMA_URL,
            class: "inline-flex items-center justify-center rounded-lg bg-gold-400 px-6 py-3.5 text-base font-semibold text-harbor-950 shadow-lg shadow-harbor-950/30 transition hover:bg-gold-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-200",
            target: "_blank", rel: "noopener" do %>
        RSVP for the next meetup
      <% end %>

      <%= link_to "See what's coming up", root_path(anchor: "events"),
            class: "inline-flex items-center justify-center rounded-lg border border-harbor-300/40 px-6 py-3.5 text-base font-semibold text-marble-50 transition hover:border-harbor-200 hover:bg-harbor-800/60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-300" %>
    </div>

    <p class="mt-8 max-w-xl text-sm leading-relaxed text-harbor-200">
      New to Ruby, or new to town? Come anyway — we staff a newcomer table at
      every event. Everyone here agrees to our
      <%= link_to "code of conduct", code_of_conduct_path,
            class: "font-semibold text-gold-300 underline decoration-gold-300/40 underline-offset-4 transition hover:decoration-gold-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-300" %>.
    </p>
  </div>

  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-32 sm:h-40 lg:h-48">
    <%= render "shared/rowhouses", classes: "h-full w-full" %>
  </div>
</section>
