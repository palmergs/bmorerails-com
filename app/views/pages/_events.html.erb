<section id="events" class="bg-marble-50 py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2 class="font-display text-3xl font-bold text-harbor-900 sm:text-4xl">
          Upcoming events
        </h2>
        <p class="mt-2 max-w-xl text-base leading-relaxed text-harbor-700">
          We gather monthly. Talks, hack nights, and the occasional excuse to
          stand around a table arguing about ActiveRecord.
        </p>
      </div>

      <%= link_to Site::LUMA_URL,
            class: "shrink-0 self-start rounded-md text-sm font-semibold text-brick-700 underline decoration-brick-300 underline-offset-4 transition hover:text-brick-900 hover:decoration-brick-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brick-500 sm:self-auto",
            target: "_blank", rel: "noopener" do %>
        Full calendar on Luma <span aria-hidden="true">&rarr;</span>
      <% end %>
    </div>

    <% if events.any? %>
      <ul class="mt-8 flex flex-col gap-4 sm:mt-10">
        <% events.each do |event| %>
          <li>
            <article class="group flex flex-col gap-4 rounded-xl border border-marble-300 bg-white p-5 shadow-sm transition hover:border-harbor-300 hover:shadow-md sm:flex-row sm:gap-6 sm:p-6">
              <%# Date block: reads as a calendar tear-off at every width. %>
              <div class="flex shrink-0 items-center gap-3 sm:w-24 sm:flex-col sm:items-center sm:gap-0 sm:border-r sm:border-marble-200 sm:pr-6">
                <span class="text-sm font-semibold tracking-widest text-brick-600 uppercase sm:text-xs">
                  <%= event.starts_at.strftime("%b") %>
                </span>
                <span class="font-display text-3xl leading-none font-bold text-harbor-900 sm:mt-1 sm:text-4xl">
                  <%= event.starts_at.strftime("%-d") %>
                </span>
                <span class="text-sm text-harbor-600 sm:mt-1 sm:text-xs sm:tracking-wide sm:uppercase">
                  <%= event.starts_at.strftime("%a") %>
                </span>
              </div>

              <div class="min-w-0 flex-1">
                <h3 class="font-display text-xl leading-snug font-semibold text-harbor-900 sm:text-2xl">
                  <% if event.url.present? %>
                    <%= link_to event.title, event.url,
                          class: "rounded-sm transition hover:text-brick-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brick-500",
                          target: "_blank", rel: "noopener" %>
                  <% else %>
                    <%= event.title %>
                  <% end %>
                </h3>

                <p class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-harbor-700">
                  <time datetime="<%= event.starts_at.iso8601 %>" class="font-medium">
                    <%= event.time_range %>
                  </time>
                  <% if event.location.present? %>
                    <span class="text-marble-300" aria-hidden="true">|</span>
                    <span><%= event.location %></span>
                  <% end %>
                </p>

                <% if event.summary.present? %>
                  <p class="mt-3 text-base leading-relaxed text-harbor-800">
                    <%= event.summary %>
                  </p>
                <% end %>
              </div>
            </article>
          </li>
        <% end %>
      </ul>
    <% else %>
      <%# Shown when nothing is scheduled — and, once Luma is wired up, when we
          cannot reach it. Never leave people staring at an empty container. %>
      <div class="mt-8 rounded-xl border border-dashed border-marble-300 bg-white/60 p-8 text-center sm:mt-10 sm:p-12">
        <h3 class="font-display text-xl font-semibold text-harbor-900">
          Nothing on the calendar just yet
        </h3>
        <p class="mx-auto mt-2 max-w-md text-base leading-relaxed text-harbor-700">
          We're between meetups. The next one gets posted to Luma first, so
          subscribe there and you'll hear about it the moment it's set.
        </p>
        <%= link_to Site::LUMA_URL,
              class: "mt-6 inline-flex items-center justify-center rounded-lg bg-harbor-800 px-5 py-3 text-sm font-semibold text-marble-50 transition hover:bg-harbor-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-harbor-500",
              target: "_blank", rel: "noopener" do %>
          Subscribe on Luma
        <% end %>
      </div>
    <% end %>
  </div>
</section>
